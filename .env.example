# =====================================================================
# CamRent — variables d'environnement (miroir versionné, SANS secrets)
# Copier vers `.env` puis adapter :   cp .env.example .env
#
# ⚠️ RIEN ne charge `.env` automatiquement côté Python :
#   - `docker compose` le lit pour la substitution (${POSTGRES_*}) ;
#   - `dbt` le lit aussi (python-dotenv) ;
#   - les CLIs Python (`pipelines`, `python -m ml.src`) NON.
#   Pour les exposer dans un shell :   set -a; . ./.env; set +a
#
# ⚠️ Ne JAMAIS laisser une variable vide (`VAR=`) : les chemins passent par
#    `Path(os.environ.get(...))`, et `Path("")` vaut `.` — les artefacts seraient
#    écrits à la racine du dépôt. Une option non utilisée reste COMMENTÉE.
# =====================================================================

# --- PostgreSQL (docker compose up postgres) -------------------------
POSTGRES_USER=camrent
# ⚠️ À REMPLACER par un mot de passe de votre choix.
#    Attention : il n'est appliqué qu'au PREMIER démarrage (volume déjà initialisé)
#    — pour le changer réellement, il faut recréer le volume.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=camrent
# Hôte : 5432 est occupé par le PostgreSQL système de cette machine, d'où 5433.
# Sur une machine sans PostgreSQL local, 5432 convient (défaut de docker compose).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Chaîne de connexion utilisée par `pipelines load` et tout le ML (Phases 4-7)
DATABASE_URL=postgresql://camrent:change-me@localhost:5433/camrent

# --- dbt (profiles.yml : DBT_* sont obligatoires, pas de valeur par défaut) ---
DBT_TARGET=dev
DBT_HOST=localhost
DBT_PORT=5433
DBT_USER=camrent
DBT_PASSWORD=change-me
DBT_DBNAME=camrent
# Séparation des environnements (lot C) : `dev` et `prod` n'écrivent JAMAIS
# dans le même schéma. `DBT_SCHEMA` reste lisible comme fallback de `DBT_SCHEMA_DEV`.
DBT_SCHEMA=analytics
# DBT_SCHEMA_DEV=analytics        # défaut : reprend DBT_SCHEMA si défini
# DBT_SCHEMA_PROD=analytics_prod  # créé au premier `dbt build --target prod`

# --- MLflow (Phase 7) --------------------------------------------------
# L'URI de suivi est DÉRIVÉE de DATABASE_URL (base `MLFLOW_DATABASE_NAME`) :
# créer la base dédiée une fois —
#   createdb -h localhost -p 5433 -U camrent mlflow
MLFLOW_DATABASE_NAME=mlflow
MLFLOW_EXPERIMENT=rent_prediction
MLFLOW_REGISTERED_MODEL=rent-model
# Télémétrie coupée en local (vitesse + reproductibilité).
MLFLOW_DISABLE_TELEMETRY=true
# Optionnel : viser un autre backend (serveur MLflow, autre base) que la dérivation.
# MLFLOW_TRACKING_URI=postgresql+psycopg://camrent:<mot-de-passe>@localhost:5433/mlflow
# Emplacement des artefacts de run : ÉPINGLÉ par défaut sur un chemin du projet
# (artefacts régénérables, ignorés par git), pour ne pas dépendre du répertoire
# courant au moment de l'exécution. Ne le redéfinir que pour un stockage dédié.
# MLFLOW_ARTIFACT_LOCATION=ml/artifacts/mlflow

# --- Artefacts ML (Phases 5-7) ----------------------------------------
# Par défaut le code écrit dans ml/models, ml/artifacts et ml/mlruns.
# Exception versionnée : `ml/models/champion.json` épingle la version servie
# (nom, version, run, empreinte du dataset, approbation) — aucun secret dedans.
# CAMRENT_MODELS_DIR=/chemin/vers/models
# CAMRENT_ML_ARTIFACTS=/chemin/vers/artifacts
# CAMRENT_MLFLOW_DIR=/chemin/vers/mlruns
# Graine de la séparation 70/15/15. La changer invalide la comparaison avec les
# rapports Phase 5 et Phase 6 (seuil de référence et modèle retenu recalculés).
CAMRENT_ML_SEED=20261009
# Seuil de publication des statistiques par segment (décision Phase 3).
CAMRENT_MIN_SEGMENT_N=30

# --- Pipelines / qualité des données (Phases 2-4) ---------------------
# Schémas dbt réels : landing (chargeur Silver) et analytics_marts (modèles).
DBT_LANDING_SCHEMA=landing
DBT_MARTS_SCHEMA=analytics_marts
# Bornes de plausibilité : les valeurs hors bornes sont SIGNALÉES, jamais supprimées.
CAMRENT_PRICE_MIN=10000
CAMRENT_PRICE_MAX=2000000
CAMRENT_ROOMS_MAX=10
# Racine des données (défaut : racine du dépôt).
# CAMRENT_DATA_ROOT=/chemin/vers/data

# --- Ingestion (Phase 1) ---------------------------------------------
# ⚠️ À REMPLACER : contact affiché dans le User-Agent (transparence de collecte).
CAMRENT_CONTACT_EMAIL=votre.adresse@example.com
# Débit volontairement poli : ne pas accélérer sans re-vérifier CGU / robots.txt.
CAMRENT_RATE_LIMIT=2.0
CAMRENT_REQUEST_TIMEOUT=20.0
CAMRENT_MAX_RETRIES=3
CAMRENT_DETAIL_BUDGET=20
CAMRENT_FRESHNESS_DAYS=7
CAMRENT_MIN_RECORDS=1
CAMRENT_KOUTCHOUMI_MAX_PAGES=1

# --- Phase 8 — API publique (FastAPI, 8000 par convention) ------------
# API_HOST=localhost
# API_PORT=8000

# --- Phase 8b — API interne du back-office (Django, 8001) -------------
# Application SÉPARÉE de l'API publique : authentifiée, réservée au rôle `admin`,
# journal d'audit. Elle réutilise `DATABASE_URL` ci-dessus.
# ⚠️ OBLIGATOIRE pour démarrer l'API interne. Remplacer par une clé générée :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
INTERNAL_SECRET_KEY=change-me-cle-de-developpement-uniquement
# Facultatives : liste d'hôtes autorisés, mode debug local, durée de vie d'un
# jeton (heures, défaut 12).
# INTERNAL_ALLOWED_HOSTS=localhost,127.0.0.1
# INTERNAL_DEBUG=1
# INTERNAL_TOKEN_TTL_HOURS=12

# --- CORS de l'API publique (Phase 9a) --------------------------------
# Opt-in : origines autorisées à appeler l'API depuis un navigateur, séparées
# par des virgules (ex. `http://localhost:3000,https://camrent.example`). Vide,
# **aucune** en-tête CORS n'est émise. En production, une seule origine avec
# reverse proxy rend cette variable inutile.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Phase 9a — frontend (Next.js) ------------------------------------
# ⚠️ Next lit `frontend/.env.local`, PAS ce fichier : le miroir opérationnel
#    est `frontend/.env.example`. Cette entrée documente la variable commune.
# Inlinée AU BUILD : changer l'URL impose de reconstruire le frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Phase 12 — observabilité (pas encore lue par le code) ------------
# SENTRY_DSN=
