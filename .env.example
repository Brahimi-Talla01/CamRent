# Copier ce fichier vers .env et renseigner les valeurs.
# Ne jamais committer .env.

# --- PostgreSQL (docker compose up postgres) ---
POSTGRES_USER=camrent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=camrent
POSTGRES_PORT=5432

# Chaîne de connexion utilisée par le pipeline et l'API
DATABASE_URL=postgresql://camrent:change-me@localhost:5432/camrent

