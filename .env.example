# Copier ce fichier vers .env et renseigner les valeurs.
# Ne jamais committer .env.

# --- PostgreSQL (docker compose up postgres) ---
POSTGRES_USER=camrent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=camrent
POSTGRES_PORT=5432

# Chaîne de connexion utilisée par le pipeline et l'API
DATABASE_URL=postgresql://camrent:change-me@localhost:5432/camrent

# --- À renseigner aux phases concernées (laisser vide pour l'instant) ---
# Phase 4  — chargeur Silver → PostgreSQL (pipelines load) : DATABASE_URL ci-dessus
#            (POSTGRES_HOST utilisé tel quel : le port 5433 est l'override local,
#            voir Session Notes du progress-tracker). Variables équivalentes pour dbt :
# DBT_HOST=localhost
# DBT_PORT=5433
# DBT_USER=camrent
# DBT_PASSWORD=change-me
# DBT_DBNAME=camrent
# DBT_SCHEMA=analytics

