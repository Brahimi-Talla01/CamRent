# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / Next.js (frontend) ---
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/

# --- Environnement / secrets ---
.env
.env.*
!.env.example

# --- Données : raw immuable et processed non versionnés ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Échantillon Phase 0 : source tierce sans licence, non redistribué ---
data/samples/*
!data/samples/.gitkeep
!data/samples/README.md

# --- Artefacts EDA régénérables (le livrable reste les rapports .md) ---
eda/statistics.json

# --- Artefacts ML ---
ml/models/*
!ml/models/.gitkeep
# Exception : la version servie est épinglée dans un fichier **versionné**
# (aucun secret, aucun binaire) — c'est le seul lien vérifiable depuis le dépôt
# vers la version enregistrée dans MLflow.
!ml/models/champion.json
# Métriques régénérables des baselines (le livrable est le rapport .md)
ml/artifacts/*
!ml/artifacts/.gitkeep

# --- MLflow (suivi Phase 7) : régénérable, le livrable reste le rapport ---
mlruns/
ml/mlruns/
mlflow.db
ml/mlartifacts/
ml/registry/

# --- dbt ---
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# --- Matériel de référence (hors projet) ---
inspire/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
