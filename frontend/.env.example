# =====================================================================
# CamRent — frontend (Phase 9a) : miroir versionné, SANS secret
#
# Copier vers `frontend/.env.local` (ignoré par git) :
#   cp frontend/.env.example frontend/.env.local
#
# ⚠️ Les variables `NEXT_PUBLIC_*` sont INLINÉES AU BUILD par Next.js :
#    changer cette URL impose de reconstruire l'application.
# =====================================================================

# Base de l'API **publique** (Phase 8a). Schéma http ou https, sans chemin :
# le client ajoute `/api/v1/...`. Absente ou invalide, l'application démarre
# mais le client API échoue explicitement (nommant cette variable), sans
# simuler de données.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
